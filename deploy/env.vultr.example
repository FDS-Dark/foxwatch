# Vultr VPS — foxwatch-xray-worker (docker compose in deploy/xray-worker)
# Do not commit real secrets.

XRAY_WORKER_IMAGE=silverdisk/foxwatch-xray-worker:latest

# Vultr Object Storage (S3-compatible). Bucket policy: public read on live/* prefixes.
VULTR_S3_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_S3_REGION=ewr1
VULTR_S3_BUCKET=foxwatch-xray
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=

# Public HTTPS base for published artifacts (no trailing slash).
# Example: https://foxwatch-xray.ewr1.vultrobjects.com
XRAY_LIVE_PUBLIC_BASE_URL=

# Optional worker tuning
# XRAY_LIVE_CACHE_DIR=/var/cache/xray-live
# XRAY_LIVE_OUTPUT_DIR=/var/lib/xray-live
