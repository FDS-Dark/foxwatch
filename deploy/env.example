# Copy values into DigitalOcean App Platform (api service) as encrypted env vars.
# Do not commit real secrets.

# Tiger / Timescale (required for observations, ingestion, RAG vectors)
TIGER_DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require

# Optional aliases also supported: TIMESCALE_SERVICE_URL, INGEST_DATABASE_URL

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

USGS_API_KEY=
USGS_STATION_ID=USGS-040851385
USGS_INGESTION_ENABLED=true

APP__environment__name=production
APP__public_url=https://www.example.com
APP__cors_origins=https://www.example.com,https://example.com
APP__jwt__secret=change-me-long-random

INGESTION_ADMIN_TOKEN=change-me-long-random

RAG_VECTOR_BACKEND=tiger

# Public Vultr Object Storage base URL for live X-Ray maps (no trailing slash).
XRAY_LIVE_PUBLIC_BASE_URL=https://your-bucket.ewr1.vultrobjects.com

HOST=0.0.0.0
PORT=8000
